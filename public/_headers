# Cabeçalhos servidos pelo Cloudflare Pages.
# Ordem importa: o bloco /* define a política geral e os blocos seguintes
# apenas ajustam Cache-Control para caminhos específicos.
#
# Como o build foi verificado (npm run build + inspeção de dist/):
#   - 0 atributos style="" no HTML  -> style-src dispensa 'unsafe-inline'
#     (motion.js escreve variáveis de progresso por CSSOM, el.style.setProperty,
#      que a CSP não filtra; quem ela filtra é o atributo style na marcação)
#   - 3 scripts, todos de /js/ same-origin -> script-src 'self'
#   - 0 requisições a terceiros, 0 webfont, 0 data URI
#   - <script type="application/ld+json"> é bloco de dados, não executável,
#     e por isso não é afetado por script-src
# Se algum destes mudar, revise esta linha antes do deploy.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Se ativar o Cloudflare Web Analytics (beacon), acrescente ao CSP:
#   connect-src 'self' https://cloudflareinsights.com
# Enquanto estiver desligado, 'self' já basta.

# public/js/*: sem hash no nome, então cache curto para atualizar junto do HTML.
/js/*
  Cache-Control: public, max-age=3600

# Assets de public/assets: 30 dias. Ao trocar um arquivo, troque o nome
# para invalidar o cache sem esperar a expiração.
/assets/*
  Cache-Control: public, max-age=2592000

# Bundles gerados pelo Astro já vêm com hash no nome: cache agressivo.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML sempre revalidado, para que publicação apareça na hora.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
