---
import { game } from '../../data/game';
import { navigation } from '../../data/navigation';

const { status, wordmark } = game;
---

<header class="cover" id="topo">
  <div class="cover__inner wrap">
    <a class="brand" href="#home" aria-label={`${game.name} — ir para o topo`}>
      <span class="brand__name">{wordmark.first} <em>{wordmark.second}</em></span>
    </a>

    <nav class="nav" aria-label="Seções do site">
      <ul class="nav__list">
        {
          navigation.map((item, i) => (
            <li>
              <a class="nav__link" href={item.href}>
                <span class="nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="cover__status">
      <span class="lamp" aria-hidden="true"></span>
      {status.badge}
    </p>
  </div>
</header>

<style>
  .cover {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(6, 17, 31, 0.97);
    border-bottom: var(--edge) solid var(--line);
  }

  /* A fileira dourada/ciano que fecha a capa da carteira. */
  .cover::after {
    content: "";
    position: absolute;
    inset: auto 0 calc(var(--edge) * -1);
    height: var(--edge);
    background: linear-gradient(
      90deg,
      var(--gold) 0 22%,
      rgba(242, 181, 60, 0.12) 22% 52%,
      var(--cyan) 52% 74%,
      rgba(94, 207, 224, 0.1) 74% 100%
    );
  }

  .cover__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex: none;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 660;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--white);
    line-height: 1;
  }

  .brand__name em {
    font-style: normal;
    color: var(--gold);
  }

  .nav {
    margin-left: auto;
    min-width: 0;
  }

  .nav__list {
    display: flex;
    gap: 0.25rem;
  }

  .nav__link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--steel);
    border-bottom: 3px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .nav__num {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    color: var(--gold-deep);
  }

  .nav__link:hover {
    color: var(--white);
    background: rgba(18, 40, 63, 0.7);
  }

  .cover__status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    padding: 0.5rem 0.85rem;
    border: var(--edge) solid var(--line);
    background: var(--panel-in);
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    white-space: nowrap;
  }

  .lamp {
    width: 9px;
    height: 9px;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(95, 208, 138, 0.18);
    animation: blink 2.4s steps(1, end) infinite;
  }

  @keyframes blink {
    0%,
    70% {
      opacity: 1;
    }
    71%,
    100% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lamp {
      animation: none;
    }
  }

  @media (max-width: 1080px) {
    .cover__status {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .cover__inner {
      min-height: 0;
      padding-block: 0.6rem;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
    }

    .nav {
      margin-left: 0;
      flex: 1 1 100%;
    }

    /* Tira rolável: quebrar o menu em duas linhas comeria a primeira dobra. */
    .nav__list {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .nav__list::-webkit-scrollbar {
      display: none;
    }

    .nav__num {
      display: none;
    }

    .nav__link {
      padding: 0.7rem 0.8rem;
      min-height: 44px;
    }
  }

  @media (max-width: 420px) {
    .brand__name {
      font-size: 1.125rem;
    }
  }

  /* Abaixo de 380px a tira rolável cortaria ROADMAP no meio: as três
     seções viram colunas iguais e o rótulo longo quebra em duas linhas. */
  @media (max-width: 380px) {
    .nav__list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      overflow: visible;
    }

    .nav__link {
      justify-content: center;
      padding-inline: 0.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.02em;
      white-space: normal;
      text-align: center;
      line-height: 1.15;
    }
  }
</style>
