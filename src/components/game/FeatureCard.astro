---
import type { SpriteName } from '../../data/sprites';
import PixelIcon from '../ui/PixelIcon.astro';

interface Props {
  icon: SpriteName | string;
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<article class="feature" data-reveal>
  <span class="feature__plate plate plate--md"><PixelIcon name={icon} /></span>
  <div class="feature__body">
    <h3 class="feature__title">{title}</h3>
    <p class="feature__text">{text}</p>
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.15rem;
    align-items: start;
  }

  .feature__plate {
    padding: 6px;
  }

  .feature__title {
    font-size: var(--fs-title);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--white);
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--gold-deep);
  }

  .feature__text {
    margin-top: 0.55rem;
    color: var(--text-soft);
    max-width: 42ch;
  }
</style>
