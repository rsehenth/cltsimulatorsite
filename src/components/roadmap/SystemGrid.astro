---
import { systemAreas, counts } from '../../data/roadmap';
import { STATUS_LABEL } from '../../data/game';
import PixelIcon from '../ui/PixelIcon.astro';

const stateOrder = ['active', 'proto', 'base'] as const;

const stateCounts = stateOrder.map((status) => ({
  status,
  label: STATUS_LABEL[status],
  count: systemAreas.filter((area) => area.status === status).length,
}));
---

<div class="systems">
  <div class="systems__bar">
    <span class="systems__bar-title">painel_de_sistemas</span>
    <span class="systems__bar-count">{counts.systems} áreas</span>
  </div>

  <ul class="systems__legend" aria-label="Sistemas por estado">
    {
      stateCounts.map((state) => (
        <li class={`systems__legend-item systems__legend-item--${state.status}`}>
          <span class="systems__legend-label">{state.label}</span>
          <span class="systems__legend-count">{state.count}</span>
        </li>
      ))
    }
  </ul>

  <ul class="systems__grid">
    {
      systemAreas.map((area) => (
        <li class={`systems__cell systems__cell--${area.status}`} data-reveal>
          <span class="systems__icon plate plate--sm"><PixelIcon name={area.icon} /></span>
          <span class="systems__name">{area.title}</span>
          <span class="systems__status">{STATUS_LABEL[area.status]}</span>
          <ul class="systems__items">
            {area.items.map((line) => <li>{line}</li>)}
          </ul>
        </li>
      ))
    }
  </ul>

  <p class="systems__foot">
    Objetivo central do protótipo: conseguir um emprego. A classificação acima é a do HTML de roadmap do projeto.
  </p>
</div>

<style>
  .systems {
    border: var(--edge) solid var(--line);
    background: var(--panel-in);
    box-shadow: var(--offset);
  }

  .systems__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    background: var(--plate);
    border-bottom: var(--edge) solid var(--line);
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .systems__bar-count {
    color: var(--gold);
  }

  /* Legenda derivada dos mesmos estados dos cards: ajuda a ler a mistura
     antes de percorrer o mosaico inteiro. */
  .systems__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: 0.6rem 1rem;
    border-bottom: var(--edge) solid var(--line-soft);
    background: var(--ink-deep);
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .systems__legend-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--steel);
  }

  .systems__legend-item::before {
    content: "";
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--tone);
  }

  .systems__legend-item--active {
    --tone: var(--cyan);
  }

  .systems__legend-item--proto {
    --tone: var(--gold);
  }

  .systems__legend-item--base {
    --tone: var(--steel);
  }

  .systems__legend-count {
    color: var(--tone);
  }

  /* Mosaico de 12 trilhos: cada linha leva um sistema ativo em dobro de
     largura e dois sistemas de apoio. A ordem dos dados é preservada. */
  .systems__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-soft);
  }

  .systems__cell {
    grid-column: span 12;
    display: grid;
    min-width: 0;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'icon name'
      'icon status'
      '.    items';
    gap: 0.15rem 0.8rem;
    align-items: center;
    padding: clamp(0.9rem, 2vw, 1.25rem);
    background: var(--panel-in);
    box-shadow: inset 0 3px 0 var(--tone);
    transition: background-color var(--dur) var(--ease);
  }

  .systems__cell--active {
    --tone: var(--cyan);
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--cyan) 9%, transparent),
      transparent 52%
    );
  }

  .systems__cell--proto {
    --tone: var(--gold);
  }

  .systems__cell--base {
    --tone: var(--steel);
  }

  @media (min-width: 640px) {
    .systems__cell {
      grid-column: span 6;
    }
  }

  @media (min-width: 980px) {
    .systems__cell {
      grid-column: span 3;
    }

    .systems__cell--active {
      grid-column: span 6;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'icon name status'
        'icon items items';
      align-items: start;
      padding: clamp(1.1rem, 1.8vw, 1.5rem);
    }

    .systems__cell--active .systems__name {
      font-size: var(--fs-title);
    }

    .systems__cell--active .systems__status {
      align-self: center;
    }
  }

  @media (hover: hover) {
    .systems__cell:hover {
      background-color: var(--panel);
    }
  }

  .systems__icon {
    grid-area: icon;
    align-self: start;
    padding: 4px;
  }

  .systems__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 620;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--white);
  }

  .systems__status {
    grid-area: status;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tone);
  }

  .systems__status::before {
    content: "";
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--tone);
  }

  .systems__items {
    grid-area: items;
    display: grid;
    gap: 0.2rem;
    margin-top: 0.6rem;
    font-size: var(--fs-note);
    line-height: 1.45;
    color: var(--steel);
  }

  .systems__foot {
    padding: 0.85rem 1rem;
    border-top: var(--edge) solid var(--line-soft);
    background: color-mix(in srgb, var(--ink-deep) 70%, transparent);
    font-size: var(--fs-note);
    color: var(--steel);
  }
</style>
