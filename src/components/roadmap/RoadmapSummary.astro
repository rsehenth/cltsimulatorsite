---
import { counts, artPhases } from '../../data/roadmap';
import PixelIcon from '../ui/PixelIcon.astro';

const metrics = [
  { icon: 'checklist', value: counts.built, label: 'Frentes construídas', note: 'no protótipo' },
  { icon: 'crt', value: counts.systems, label: 'Áreas de sistema', note: 'por dentro do protótipo' },
  { icon: 'flag', value: counts.planned, label: 'Frentes planejadas', note: 'ainda não implementadas' },
  { icon: 'palette', value: counts.art, label: 'Áreas de arte', note: 'na evolução visual' },
  { icon: 'sparkle', value: artPhases.length, label: 'Fases de arte', note: 'do protótipo ao polimento' },
] as const;
---

<div class="record" data-reveal>
  <div class="record__bar">
    <h3 class="record__bar-title">Ficha técnica</h3>
    <span class="record__bar-note">dados do roadmap</span>
  </div>

  <dl class="record__grid">
    {
      metrics.map((metric) => (
        <div class="record__item">
          <dt class="record__label">
            <span class="record__icon plate plate--sm" aria-hidden="true">
              <PixelIcon name={metric.icon} />
            </span>
            <span>{metric.label}</span>
          </dt>
          <dd class="record__value">
            <strong>{metric.value}</strong>
            <span class="record__note">{metric.note}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="record__foot">
    Contagens derivadas do roadmap.
  </p>
</div>

<style>
  .record {
    border: var(--edge) solid var(--line);
    background: var(--panel-in);
    box-shadow: var(--offset);
  }

  .record__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    background: var(--plate);
    border-bottom: var(--edge) solid var(--line);
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .record__bar-title {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    font-weight: 400;
    letter-spacing: inherit;
    color: inherit;
  }

  .record__bar-note {
    color: var(--steel);
  }

  .record__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-soft);
  }

  .record__item:last-child {
    grid-column: 1 / -1;
  }

  .record__item {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: clamp(0.85rem, 1.6vw, 1.15rem);
    background: var(--panel-in);
  }

  .record__label {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-family: var(--font-data);
    font-size: var(--fs-data);
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .record__icon {
    flex: none;
    padding: 3px;
  }

  .record__value {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    margin: 0;
  }

  .record__value strong {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 700;
    line-height: 1;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .record__note {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .record__foot {
    padding: 0.65rem 1rem;
    border-top: var(--edge) solid var(--line-soft);
    background: var(--ink-deep);
    font-size: var(--fs-note);
    color: var(--steel);
  }

  @media (max-width: 719px) {
    .record__item {
      gap: 0.4rem;
      padding: 0.7rem 0.8rem;
    }

    .record__icon {
      display: none;
    }

    .record__value {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.3rem 0.5rem;
    }
  }

  @media (max-width: 359px) {
    .record__grid {
      grid-template-columns: 1fr;
    }

    .record__item:last-child {
      grid-column: auto;
    }
  }

  /* Cinco colunas só onde o rótulo mais longo cabe inteiro. Abaixo disso cada
     célula fica estreita demais e "Frentes construídas" estoura a caixa. */
  @media (min-width: 1024px) {
    .record__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .record__item:last-child {
      grid-column: auto;
    }
  }
</style>
