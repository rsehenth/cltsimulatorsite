---
import { highlights } from '../../data/game';
import PixelIcon from '../ui/PixelIcon.astro';

const [lead, ...rest] = highlights;
---

<section class="highlights" aria-label="Destaques do jogo">
  <div class="wrap highlights__grid">
    <article class="highlights__lead cornered" data-reveal>
      <span class="highlights__plate plate plate--lg"><PixelIcon name={lead.icon} /></span>
      <div>
        <h2 class="highlights__lead-title">{lead.title}</h2>
        <p>{lead.note}</p>
      </div>
      <!-- Marca d'água desenhada com o próprio sprite da cena. -->
      <svg class="highlights__mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <use href={`#px-${lead.icon}`}></use>
      </svg>
    </article>

    <ul class="highlights__list">
      {
        rest.map((item) => (
          <li data-reveal>
            <span class="highlights__mini plate plate--sm"><PixelIcon name={item.icon} /></span>
            <span class="highlights__body">
              <strong>{item.title}</strong>
              <span>{item.note}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    padding-bottom: var(--block-space);
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  /* O primeiro destaque manda: é o maior bloco da faixa. */
  .highlights__lead {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 1.75rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(150deg, rgba(242, 181, 60, 0.13) 0%, var(--panel) 42%, var(--panel-in) 100%);
    border: var(--edge) solid var(--line);
    box-shadow: var(--offset);
  }

  /* Acima da marca d'água: texto grande nunca fica sob um gráfico. */
  .highlights__lead > div {
    position: relative;
    z-index: 1;
  }

  .highlights__mark {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    width: clamp(9rem, 16vw, 14rem);
    height: clamp(9rem, 16vw, 14rem);
    opacity: 0.1;
    pointer-events: none;
    shape-rendering: crispEdges;
  }

  .highlights__lead-title {
    font-size: var(--fs-title);
    text-transform: uppercase;
    color: var(--white);
  }

  .highlights__lead p {
    margin-top: 0.45rem;
    color: var(--text-soft);
  }

  .highlights__list {
    display: grid;
    align-content: space-between;
    gap: 0.5rem;
  }

  .highlights__list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.9rem;
    background: var(--panel-in);
    border-left: 3px solid var(--line);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .highlights__list li:hover {
      border-left-color: var(--gold);
      background: var(--panel);
    }
  }

  .highlights__mini {
    flex: none;
    padding: 4px;
  }

  .highlights__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .highlights__body strong {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 620;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--white);
  }

  .highlights__body span {
    font-size: var(--fs-note);
    color: var(--steel);
  }

  @media (max-width: 900px) {
    .highlights__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .highlights__lead {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
