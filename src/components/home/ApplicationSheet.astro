---
import { game } from '../../data/game';
import PixelIcon from '../ui/PixelIcon.astro';

const fields = [
  { label: 'Candidato', value: game.character.name },
  { label: 'Formação', value: 'Diplomas concluídos' },
  { label: 'Experiência', value: 'O mercado ainda não respondeu' },
  { label: 'Prazo', value: game.character.deadline },
  { label: 'Pretensão', value: 'Uma chance e o aluguel em dia' },
];
---

<section class="ficha" aria-labelledby="ficha-title">
  <div class="wrap ficha__wrap">
    <div class="ficha__sheet" data-reveal>
      <p class="ficha__head">
        <span>Ficha de inscrição</span>
        <span class="ficha__serial" aria-hidden="true">Nº 0005/27</span>
      </p>

      <h2 class="ficha__title" id="ficha-title">Preencha. Espere. Reabra o aplicativo.</h2>

      <dl class="ficha__fields">
        {
          fields.map((field) => (
            <div class="ficha__row">
              <dt>{field.label}</dt>
              <dd>{field.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="ficha__legal">
        Documento de brincadeira, dentro do jogo. Nada aqui é enviado, salvo ou lido por alguém.
      </p>

      <div class="ficha__stamp" data-stamp>
        <span class="ficha__stamp-inner">
          <PixelIcon name="letter" />
          <span>Sem vagas</span>
        </span>
      </div>

      <div class="ficha__slot" data-slot hidden></div>
    </div>
  </div>
</section>

<style is:global>
  .ficha {
    padding-block: var(--block-space) var(--section-space);
  }

  .ficha__wrap {
    max-width: var(--sheet-max);
  }

  /* A folha impressa: papel sobre a mesa azul-marinho. */
  .ficha__sheet {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 3.5vw, 2.75rem) clamp(3rem, 7vw, 4.5rem);
    background: var(--paper);
    color: var(--ink-on-paper);
    box-shadow: var(--offset);
    /* Borda inferior serrilhada: a folha destacada do bloco do cartório. */
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 14px),
      96% 100%, 92% calc(100% - 14px), 88% 100%, 84% calc(100% - 14px),
      80% 100%, 76% calc(100% - 14px), 72% 100%, 68% calc(100% - 14px),
      64% 100%, 60% calc(100% - 14px), 56% 100%, 52% calc(100% - 14px),
      48% 100%, 44% calc(100% - 14px), 40% 100%, 36% calc(100% - 14px),
      32% 100%, 28% calc(100% - 14px), 24% 100%, 20% calc(100% - 14px),
      16% 100%, 12% calc(100% - 14px), 8% 100%, 4% calc(100% - 14px),
      0 100%
    );
  }

  .ficha__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 3px solid var(--ink-on-paper);
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ficha__serial {
    color: var(--muted-on-paper);
  }

  .ficha__title {
    margin-top: 1.5rem;
    font-size: var(--fs-lead);
    text-transform: uppercase;
    max-width: 22ch;
    color: var(--ink-on-paper);
  }

  .ficha__fields {
    display: grid;
    gap: 0;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
  }

  .ficha__row {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.42fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px dotted rgba(20, 32, 47, 0.4);
  }

  .ficha__row:last-child {
    border-bottom: 0;
  }

  .ficha__row dt {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-on-paper);
  }

  .ficha__row dd {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 500;
  }

  .ficha__legal {
    margin-top: 1.5rem;
    font-family: var(--font-data);
    font-size: var(--fs-data);
    line-height: 1.5;
    color: var(--muted-on-paper);
    max-width: 48ch;
  }

  .ficha__stamp {
    position: absolute;
    right: clamp(1rem, 5vw, 3.5rem);
    bottom: clamp(2rem, 6vw, 3.5rem);
    rotate: -9deg;
    pointer-events: none;
  }

  .ficha__stamp-inner {
    --icon: 22px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 4px double var(--stamp);
    color: var(--stamp);
    background: rgba(216, 53, 42, 0.07);
    font-family: var(--font-display);
    font-size: var(--fs-stamp);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.82;
  }

  .ficha__stamp.is-hitting .ficha__stamp-inner {
    animation: ficha-hit 420ms var(--ease);
  }

  @keyframes ficha-hit {
    0% { scale: 2.4; opacity: 0; }
    55% { scale: 0.96; opacity: 0.9; }
    100% { scale: 1; opacity: 0.82; }
  }

  .ficha__slot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    /* Espaço reservado: o carimbo absoluto nunca pisa o botão. */
    padding-right: clamp(8rem, 22vw, 13rem);
    border-top: 2px solid rgba(20, 32, 47, 0.2);
  }

  .ficha__slot[hidden] {
    display: none;
  }

  .ficha__count {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-on-paper);
  }

  .ficha__button {
    padding: 0.8rem 1.25rem;
    border: var(--edge) solid var(--ink-on-paper);
    background: var(--stamp-deep);
    color: var(--white-warm);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 640;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 3px 3px 0 rgba(20, 32, 47, 0.45);
    transition: translate var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .ficha__button:hover {
    translate: -1px -1px;
    box-shadow: 5px 5px 0 rgba(20, 32, 47, 0.45);
  }

  .ficha__button:active {
    translate: 2px 2px;
    box-shadow: 1px 1px 0 rgba(20, 32, 47, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .ficha__stamp.is-hitting .ficha__stamp-inner {
      animation: none;
    }

    .ficha__button:hover,
    .ficha__button:active {
      translate: none;
    }
  }

  @media (max-width: 620px) {
    .ficha__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .ficha__slot {
      padding-right: 0;
    }

    .ficha__stamp {
      position: static;
      rotate: -4deg;
      display: block;
      margin-top: 1.5rem;
      text-align: center;
    }
  }
</style>

<!-- O carimbo mora em public/js/ficha.js: script externo, nunca inline, para que a CSP mantenha script-src 'self'. -->
<script is:inline defer src="/js/ficha.js"></script>
