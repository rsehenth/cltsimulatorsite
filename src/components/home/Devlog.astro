---
import { devlog } from '../../data/game';
import { validLinks } from '../../data/social';
import PixelIcon from '../ui/PixelIcon.astro';

const social = validLinks();
---

<section class="devlog" aria-labelledby="devlog-title">
  <div class="wrap devlog__panel">
    <span class="devlog__plate plate plate--md"><PixelIcon name="diary" /></span>
    <div class="devlog__body" data-reveal>
      <h2 class="devlog__title" id="devlog-title">{devlog.title}</h2>
      <p class="devlog__text">{devlog.text}</p>
      {social.length === 0 && <p class="devlog__empty">{devlog.empty}</p>}
    </div>

    {
      social.length > 0 && (
        <ul class="devlog__links" data-reveal>
          {social.map((link) => (
            <li>
              <a href={link.url} rel="noopener noreferrer" target="_blank">
                <span class="devlog__link-net">{link.label}</span>
                <span class="devlog__link-name">{link.handle || link.label}</span>
                <span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .devlog {
    padding-block: var(--block-space);
  }

  .devlog__panel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
    max-width: var(--sheet-max);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--panel-in);
    border-left: 4px solid var(--gold);
  }

  .devlog__plate {
    padding: 8px;
  }

  .devlog__title {
    font-size: var(--fs-title);
    text-transform: uppercase;
    color: var(--white);
  }

  .devlog__text {
    margin-top: 0.7rem;
    max-width: 62ch;
    color: var(--text-soft);
  }

  /* O canal é a ação da faixa: bloco com rede e nome, não uma etiqueta de
     13 px colada no fim do parágrafo. */
  .devlog__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    grid-column: 1 / -1;
  }

  .devlog__links a {
    display: grid;
    gap: 0.2rem;
    min-width: min(100%, 15rem);
    padding: 0.9rem 1.25rem;
    background: var(--panel);
    border: var(--edge) solid var(--line);
    box-shadow: var(--offset-sm);
    text-decoration: none;
    transition: translate var(--dur) var(--ease), border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .devlog__link-net {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .devlog__link-name {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 640;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--white);
  }

  .devlog__links a:hover {
    translate: -2px -2px;
    border-color: var(--cyan);
    background: var(--plate);
  }

  .devlog__links a:active {
    translate: 2px 2px;
  }

  .devlog__empty {
    margin-top: 1.1rem;
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
  }

  @media (min-width: 1100px) {
    /* Em tela larga a faixa ocupa a mesa inteira, como o painel do HUD logo
       acima: texto à esquerda, canal à direita. Vazio à direita de um painel
       não é respiro, é seção mal construída. */
    .devlog__panel {
      max-width: none;
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    /* O canal ocupa a metade direita inteira: o bloco cresce até a borda do
       painel em vez de flutuar sozinho num canto. */
    .devlog__links {
      grid-column: auto;
      align-items: stretch;
    }

    .devlog__links li {
      flex: 1 1 15rem;
      display: flex;
    }

    .devlog__links a {
      flex: 1;
      align-content: center;
      min-height: 6rem;
      padding-inline: clamp(1.25rem, 3vw, 2.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .devlog__links a:hover,
    .devlog__links a:active {
      translate: none;
    }
  }

  @media (max-width: 560px) {
    .devlog__panel {
      grid-template-columns: 1fr;
    }
  }
</style>
