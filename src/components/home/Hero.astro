---
import { game } from '../../data/game';

const { hero, status, demo } = game;
---

<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <figure class="hero__art" data-reveal>
      <div class="hero__cover cornered">
        <p class="hero__cover-head">Carteira de Trabalho · Protótipo</p>
        <img
          src="/assets/branding/clt-logo.png"
          width="960"
          height="480"
          alt="CLT Simulator — Carteira de Trabalho, sem vagas"
          fetchpriority="high"
          decoding="async"
        />
        <dl class="hero__facts">
          <div>
            <dt>Situação</dt>
            <dd>{status.label}</dd>
          </div>
          <div>
            <dt>Demo</dt>
            <dd>{demo.year}</dd>
          </div>
          <div>
            <dt>Gênero</dt>
            <dd>Simulação de vida</dd>
          </div>
        </dl>
      </div>
      <figcaption class="hero__caption">Arte oficial do projeto. Capturas do jogo entram aqui quando existirem.</figcaption>
    </figure>

    <div class="hero__text" data-reveal>
      <h1 class="hero__title" id="hero-title">{hero.headline}</h1>
      <p class="hero__sub">{hero.subheadline}</p>
      <p class="hero__desc">{hero.description}</p>

      <p class="hero__badge">
        <span class="lamp" aria-hidden="true"></span>
        {status.label} — {status.badge}
      </p>

      <p class="hero__demo">
        <span class="hero__demo-year">{demo.year}</span>
        <span class="hero__demo-label">{demo.kicker}: demo</span>
      </p>

      <p class="hero__actions">
        <a class="btn" href="#jogo">Conhecer o jogo</a>
        <a class="btn btn--ghost" href="#roadmap">Ver o roadmap</a>
      </p>

      <p class="hero__note">{demo.note}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5.5rem) var(--block-space);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* ---------- A capa da carteira ---------- */

  .hero__art {
    margin: 0;
    order: 2;
  }

  .hero__cover {
    position: relative;
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.25rem, 2.6vw, 2.25rem);
    background: linear-gradient(168deg, var(--panel) 0%, var(--panel-in) 100%);
    border: var(--edge) solid var(--line);
    box-shadow: var(--offset);
  }

  .hero__cover-head {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .hero__cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    background: rgba(5, 14, 27, 0.5);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding-top: clamp(0.9rem, 1.6vw, 1.25rem);
    border-top: var(--edge) solid var(--line-soft);
  }

  .hero__facts dt {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .hero__facts dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 620;
    letter-spacing: 0.02em;
    color: var(--gold);
    line-height: 1.2;
  }

  .hero__caption {
    margin-top: 0.85rem;
    font-family: var(--font-data);
    font-size: var(--fs-data);
    line-height: 1.5;
    color: var(--steel-dim);
  }

  /* ---------- Texto ---------- */

  .hero__text {
    order: 1;
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--white);
    /* 15ch na própria escala: quebra em duas linhas cheias, não em quatro. */
    max-width: 15ch;
  }

  .hero__sub {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 560;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--gold);
    max-width: 24rem;
  }

  .hero__desc {
    margin-top: 1.25rem;
    max-width: 34rem;
    color: var(--text);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.5rem 0.9rem;
    border: var(--edge) solid var(--line);
    background: var(--panel-in);
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
  }

  .lamp {
    width: 9px;
    height: 9px;
    flex: none;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(95, 208, 138, 0.18);
    animation: blink 2.4s steps(1, end) infinite;
  }

  @keyframes blink {
    0%, 70% { opacity: 1; }
    71%, 100% { opacity: 0.35; }
  }

  .hero__demo {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .hero__demo-year {
    font-family: var(--font-display);
    font-size: var(--fs-num);
    font-weight: 700;
    line-height: 0.9;
    color: var(--cyan);
  }

  .hero__demo-label {
    font-family: var(--font-data);
    font-size: var(--fs-data);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1rem;
    font-size: var(--fs-note);
    color: var(--steel);
    max-width: 30rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .lamp {
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero__art {
      order: 1;
    }

    .hero__text {
      order: 2;
    }

    .hero__title {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .hero__facts {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .hero__facts div:last-child {
      grid-column: 1 / -1;
    }

    .hero__cover img {
      aspect-ratio: auto;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
